{
  "name": "battle-city-reforged-frontend",
  "version": "1.0.0",
  "description": "The browser client for NO WarThunder: ten original missions, one city to defend.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-bootstrap.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "private": true
}
